# Application
NODE_ENV=development
PORT=4000
WEB_PORT=5173

# JWT & Security
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this
REFRESH_TOKEN_EXPIRE=30d

# URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/luvnexa
DATABASE_DIRECT_URL=postgresql://postgres:password@localhost:5432/luvnexa

# Supabase (optional - for production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Firebase Storage
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Cloudinary (alternative storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service (Resend or SendGrid)
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_FROM_EMAIL=noreply@luvnexa.com

# Admin Account (seed data)
ADMIN_EMAIL=admin@luvnexa.com
ADMIN_PASSWORD=change_this_password_in_production

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_URL=http://localhost:5173

# Analytics (optional)
PLAUSIBLE_DOMAIN=

# Stripe (for future payments)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug