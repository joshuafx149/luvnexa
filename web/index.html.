
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Luvnexa | Connect Together</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f8f1ff;color:#30213d;display:grid;place-items:center;min-height:100vh;padding:20px}
main{background:white;width:100%;max-width:420px;padding:28px;border-radius:22px;box-shadow:0 8px 30px #39204b18}
h1{text-align:center;color:#9145c5;margin-bottom:5px}
p{text-align:center;color:#75687d}
input,button{width:100%;padding:14px;margin-top:12px;border-radius:10px;font-size:16px}
input{border:1px solid #ddd}
button{border:0;background:#9145c5;color:white;font-weight:bold;cursor:pointer}
button.secondary{background:#eee5f5;color:#54316b}
#message{overflow-wrap:anywhere;font-size:14px}
[hidden]{display:none!important}
</style>
</head>
<body>
<main>
<h1>💜 Luvnexa</h1>
<p>Connect with people and share your moments.</p>

<section id="auth">
<input id="email" type="email" placeholder="Email address" autocomplete="email" required>
<input id="password" type="password" placeholder="Password (at least 6 characters)" autocomplete="current-password" required>
<button id="signup">Create Account</button>
<button id="login" class="secondary">Log In</button>
<p id="message" role="status"></p>
</section>

<section id="home" hidden>
<h2>Welcome to Luvnexa!</h2>
<p id="account"></p>
<button id="logout">Log Out</button>
</section>
</main>

<script type="module">
import { createClient } from
'https://esm.sh/@supabase/supabase-js@2';

const SUPABASE_URL = 'PASTE_YOUR_SUPABASE_PROJECT_URL';
const SUPABASE_KEY = 'PASTE_YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY';

const message = document.getElementById('message');
const auth = document.getElementById('auth');
const home = document.getElementById('home');
const email = document.getElementById('email');
const password = document.getElementById('password');

const configured =
  SUPABASE_URL.startsWith('https://') &&
  !SUPABASE_URL.includes('PASTE_') &&
  !SUPABASE_KEY.includes('PASTE_');

if (!configured) {
  message.textContent =
    'Setup needed: add your Supabase URL and public key in the code.';
} else {
  const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

  async function showSession() {
    const { data } = await supabase.auth.getSession();
    const user = data.session?.user;
    auth.hidden = !!user;
    home.hidden = !user;
    document.getElementById('account').textContent =
      user ? 'Signed in as ' + user.email : '';
  }

  document.getElementById('signup').onclick = async () => {
    message.textContent = 'Creating account...';
    if (!email.value.trim() || password.value.length < 6) {
      message.textContent =
        'Enter a valid email and a password with at least 6 characters.';
      return;
    }
    const { data, error } = await supabase.auth.signUp({
      email: email.value.trim(),
      password: password.value
    });
    if (error) {
      message.textContent = error.message;
    } else if (!data.session) {
      message.textContent =
        'Account created. Check your email to confirm, then log in.';
    } else {
      message.textContent = 'Account created!';
      await showSession();
    }
  };

  document.getElementById('login').onclick = async () => {
    message.textContent = 'Logging in...';
    const { error } = await supabase.auth.signInWithPassword({
      email: email.value.trim(),
      password: password.value
    });
    if (error) {
      message.textContent = error.message;
    } else {
      message.textContent = 'Login successful!';
      await showSession();
    }
  };

  document.getElementById('logout').onclick = async () => {
    const { error } = await supabase.auth.signOut();
    message.textContent = error ? error.message : '';
    await showSession();
  };

  supabase.auth.onAuthStateChange(() => {
    showSession();
  });

  showSession();
}
</script>
</body>
</html>
